{
  "kernel": "matmul_f16_ws_1p1c",
  "framework": "choreo",
  "arch": "sm_90a",
  "notes": "Warp-specialized 1P1C GEMM from matmul_warpspec.co. Producer loads LHS/RHS tiles via TMA, consumer does WGMMA and writes output.",
  "warp_groups": [
    {
      "wg_id": 0,
      "role": "producer",
      "phases": [
        {
          "label": "P0_wait_empty",
          "signal_in": "empty",
          "signal_out": null,
          "buffers": []
        },
        {
          "label": "P1_load_tiles",
          "signal_in": null,
          "signal_out": "full",
          "buffers": ["lhs_s", "rhs_s"]
        }
      ]
    },
    {
      "wg_id": 1,
      "role": "consumer",
      "phases": [
        {
          "label": "C0_init",
          "signal_in": null,
          "signal_out": "empty",
          "buffers": []
        },
        {
          "label": "C1_compute",
          "signal_in": "full",
          "signal_out": "empty",
          "buffers": ["lhs_s", "rhs_s"]
        },
        {
          "label": "C2_epilogue",
          "signal_in": null,
          "signal_out": null,
          "buffers": ["output_s"]
        }
      ]
    }
  ],
  "shared_buffers": {
    "lhs_s": {"size_bytes": 32768, "description": "LHS tile [128x64 f16, 2 stages]"},
    "rhs_s": {"size_bytes": 32768, "description": "RHS tile [64x128 f16, 2 stages]"},
    "output_s": {"size_bytes": 32768, "description": "Output tile [128x128 f16]"}
  }
}
